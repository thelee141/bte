{
  "name": "bte-sportbook",
  "version": "0.1.0",
  "private": true,
  "description": "Original sportsbook platform (play-money dev). See SPORTSBOOK_MASTER_PLAN.md.",
  "type": "module",
  "scripts": {
    "dev:api": "tsx src/app/server.ts",
    "dev:web": "vite",
    "typecheck": "pnpm run typecheck:core && pnpm run typecheck:web",
    "typecheck:core": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm run build:core && pnpm run build:web",
    "build:core": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/src/app/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.1",
    "vitest": "3.2.7"
  }
}
