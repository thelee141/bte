# PostgreSQL database used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/bte_dev?schema=public"

# Optional customer/API server settings.
HOST="127.0.0.1"
PORT="4100"

# Deterministic play-money realtime fixture interval in milliseconds.
# Minimum accepted value: 250.
REALTIME_TICK_MS="4000"
